{
  "name": "doku-indexer",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@hono/node-server": "^1.13.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@types/ws": "^8.18.1",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "pglite-prisma-adapter": "^0.7.2",
    "tsx": "^4.19.0",
    "viem": "^2.21.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.39.5",
    "prisma": "^7.9.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
