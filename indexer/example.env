# Indexer configuration.
#
# Everything here is validated at boot. A value that is missing or malformed stops the process with
# a message naming all of them at once, rather than starting and looking healthy.

# --- chain ---

# The chain to follow, over HTTP. This is the source of truth for what has been indexed.
MONAD_RPC_URL=http://127.0.0.1:8545
# 143 is Monad mainnet, which is the only chain DOKU can run on: Uniswap v4 is not deployed on
# testnet, so a market there can launch and fill and then has nowhere to graduate into.
MONAD_CHAIN_ID=143

# Optional. Heard-about-it-sooner, nothing more: new heads arrive here instead of waiting for the
# next poll. Unset or disconnected, the HTTP path above still indexes every block.
# MONAD_WS_URL=wss://testnet-rpc.monad.xyz

# Where the protocol lives. The indexer only records events from these.
FACTORY_ADDRESS=
GRADUATION_ADDRESS=

# The Uniswap v4 PoolManager. Not ours — Uniswap's, and the same on every DOKU market.
#
# REQUIRED, and it is the one whose absence used to be silent. Every graduated market's swaps come
# from this singleton and nowhere else, so without it no swap query is issued at all — and the
# symptom is not an error. Charts and trade feeds simply stop at the moment each curve closed,
# which looks exactly like a market nobody is trading.
#
# Monad mainnet (143):
POOL_MANAGER_ADDRESS=0x188d586Ddcf52439676Ca21A244753fA19F9Ea8e

# Where to begin. Use the factory's deployment block: earlier is wasted scanning, later silently
# misses markets.
START_BLOCK=0

# How many blocks one eth_getLogs may cover. Monad's public RPC rejects more than 100 outright,
# which presents as an indexer that never advances while reporting zero lag. A dedicated node
# allows far more.
# INDEXER_BATCH_SIZE=100

# --- service ---

# Serves both the REST API and the client feed at /live.
PORT=3010

# Postgres. Omit entirely for local development — the service then runs Postgres in-process, which
# is the same engine, so nothing about the SQL changes. Supply it in a deployment: the in-process
# engine lives in memory, so without it every restart starts from an empty database.
# DATABASE_URL=postgres://user:pass@host:5432/doku

# Pooled connections the managed client may open.
# DATABASE_POOL_SIZE=10

# --- generation 2 (DOKU Pairs) ---
# All optional. Unset, the indexer follows the gen-1 emoji launchpad only, which is the rollback.
# Set all five together once the gen-2 contracts are deployed (deploy order in the contracts plan).
# DOKU_FACTORY2_ADDRESS=
# DOKU_QUOTE_REGISTRY=
# DOKU_CREATOR_SINK=
# DOKU_HOOK2=
# DOKU_GRADUATION2=

# USD quotes, refreshed every 60 s. A JSON document: either { "prices": { "<address|symbol>": n } }
# or a flat { "<address|symbol>": n }. Keys are matched case-insensitively against a quote asset's
# address (address(0) or "mon" for native MON) or symbol. Stablecoins are pinned to 1 regardless.
#
# THIS IS NOT COSMETIC. The board orders by USD market cap; a quote with no price falls back to
# whole units of its own quote, which compares one ounce of gold against one dollar as if they were
# the same size. Measured: a gold market holding ~$10M ranked third, behind a $2M one. `/status`
# reports `unpriced_quotes`, and a non-zero value there means the board is MIS-ORDERED, not merely
# missing a column. The document must carry a price for every launch asset — MON, WETH, WBTC,
# cbBTC, XAUt0 and the tokenised equities; the stablecoins are pinned by the job either way.
#
# Absent: usd_price stays null and the UI shows quote-denominated figures only.
# PRICE_SOURCE_URL=

# Bearer token the frontend's /api/uploads/image route sends to POST /uploads and DELETE
# /uploads/:cid. Absent: those writes answer 403 and only GET /uploads/:cid is served.
# UPLOADS_TOKEN=

# --- graduation keeper ---
# A filling buy graduates its market in the same transaction, unless it was sent with too little
# gas — then the graduation is swallowed, the curve closes, and the market has no pool until
# somebody calls `graduate()` again. With this set, the indexer is that somebody: every 10 s it
# graduates any served market that is ready and poolless, after checking the chain agrees.
#
# A DEDICATED key that holds gas and nothing else. `graduate()` is permissionless and can only do
# the one correct thing, so a leaked keeper key can lose its own balance and no more. NEVER the
# deploy key. Keep it above Monad's 10 MON reserve plus ~0.35 MON per graduation (billed at the
# gas LIMIT, ~3.1M gas); `/status` → `indexer.keeper.heldByReserve` rising means top it up.
#
# Absent: no keeper. A stranded market shows "Graduate this market" in the app instead.
# KEEPER_PRIVATE_KEY=

# The same key finishes the buyback on graduated BURN markets: after graduation the hook holds the
# sink's levy in the token until somebody sends `sweep` and `BurnSink.burn()`. Every 30 minutes the
# keeper does, at most once a day per market and only when the burn destroys at least this many
# dollars of tokens (default 100; 0 burns any amount; plain digits only, blank means the default).
# It burns only at the sink the hook itself names, never pays more than 0.25 MON for one
# transaction, does nothing while the database is behind the chain, and stands down entirely when
# the keeper is under 30 MON. Needs DOKU_HOOK2. `off` (or false/0/no) stops the job and nothing
# else: the tokens wait in the hook, out of circulation. Anything unrecognised is refused at boot.
# KEEPER_BURN=off
# KEEPER_BURN_MIN_USD=100

# --- token metadata documents (generation 6) ---
# `DokuToken.metadataURI()` returns `https://cdn.doku.family/metadata/<token>.json`. This process
# writes that document on every MetadataSet it ingests (launch and every creator edit), to the same
# R2 bucket the frontend uploads images to. Same variable names as the frontend. Off when unset.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=https://cdn.doku.family
# What `createdOn`/`external_url` name. Default https://doku.family.
# METADATA_SITE_URL=https://doku.family

# --- explorer verification of launched clones (generation 6) ---
# Every launch deploys two EIP-1167 clones (token + curve). With a key, this process marks each one
# on MonadScan as a proxy of its verified implementation (`verifyproxycontract`), asynchronously,
# with retries; outcomes land in `contract_verifications` and scripts/verify-clones.ts finishes
# anything the process could not wait out. The implementations themselves are verified once per
# generation by contracts/script/verify.sh (Sourcify/MonadVision needs no key and no per-clone call).
# Off when unset. The key is never logged.
# MONADSCAN_API_KEY=
# MONADSCAN_API_URL=https://api.etherscan.io/v2/api
# SOURCIFY_API_URL=https://sourcify-api-monad.blockvision.org
